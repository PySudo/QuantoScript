text = "Quanto"
number = 3
flag = true
nothing = null
items = ["red", "green"]
person = {"name": "Sara"}

print(type(text))
print(type(number))
print(type(3.5))
print(type(flag))
print(type(nothing))
print(type(items))
print(type(person))

print(isinstance(text, "string"))
print(isinstance(number, "int"))
print(isinstance(number, int))
print(isinstance(number, "string"))
